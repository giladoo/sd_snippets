<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="website_comments_list" model="ir.ui.view">
        <field name="name">Comments</field>
        <field name="model">sd_snippets.comments</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="rec_date"/>
<!--                <field name="content"/>-->
                <field name="published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="website_comments_form" model="ir.ui.view">
        <field name="name">Comments</field>
        <field name="model">sd_snippets.comments</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="o_row">
                        <div class="col-6">
                            <label for="rec_date" class="mx-3 mb-5"/>
                            <field name="rec_date"/>
                        </div>
                        <div class="col-6">
                            <label for="published" class="mx-3 mb-5"/>
                            <button class="oe_stat_button  mx-3"  icon="" string="Published" name="toggle_publish" type="object">
                                <field name="published" string="Published" widget="boolean_toggle" class="oe_stat_button"/>
                                <!--                                <field string="Published" name="published" widget="statinfo"/>-->
                            </button>

                        </div>

                    </div>

                    <div class=" col-12 h4 o_title">
                        <field name="title"/>
                    </div>

                    <group>
                        <group>

                        </group>
                        <group>

                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content" widget="html"/>

                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>

        </field>
    </record>

    <record id="website_comments_search" model="ir.ui.view">
        <field name="name">Comments</field>
        <field name="model">sd_snippets.comments</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="rec_date"/>
                <field name="content"/>
                <field name="published"/>
                <filter name="published_items" string="Published" domain="[('published', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="website_comments" model="ir.actions.act_window">
            <field name="name">Comments</field>
            <field name="res_model">sd_snippets.comments</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_published_items': 1}</field>
    </record>

        <menuitem name="Internal News"
                  id="comments"
                  sequence="302"
                  parent="website.menu_site"
                action="sd_snippets.website_comments"/>
</odoo>